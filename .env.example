# 복사해서 .env 로 만들고 값을 채우세요. (.env 는 절대 커밋 금지)

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # 백엔드 전용. 프론트에 넣지 말 것
SUPABASE_JWT_SECRET=            # Supabase 대시보드 > Project Settings > API

# ---------- 프론트 (VITE_ 로 시작해야 브라우저에서 읽힘) ----------
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_KAKAO_MAP_KEY=
VITE_VAPID_PUBLIC_KEY=

# ---------- 외부 API ----------
ODSAY_API_KEY=
KMA_API_KEY=
SEOUL_OPENAPI_KEY=              # ML 데이터 수집용

# ---------- Web Push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# ---------- 기타 ----------
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
